<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/ivplayer/db" VERSION="20261115" COMMENT="Interactive Video Player tables">
  <TABLES>
    <TABLE NAME="ivplayer" COMMENT="Interactive Video Player instances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="vimeoid" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="vimeohash" TYPE="char" LENGTH="64" NOTNULL="false"/>
        <FIELD NAME="videourl" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="videoloop" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="etiquetas" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="glosario" COMMENT="Labels: glosario (interactive glossary) or pantalla (pins over the video)"/>
        <FIELD NAME="interactions" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="completioninteractions" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="grade" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="ivplayer_progress" COMMENT="Per-user progress for Interactive Video Player">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="ivplayerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="completed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="progress" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="ivplayerid" TYPE="foreign" FIELDS="ivplayerid" REFTABLE="ivplayer" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="ivplayerid-userid" TYPE="unique" FIELDS="ivplayerid, userid"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="ivplayer_answers" COMMENT="Latest answer per user per gradable interaction">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="ivplayerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="interactionid" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="answer" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="correct" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="firstanswer" TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="First answer (1.5.0). NULL on rows from before 1.5.0: unknown"/>
        <FIELD NAME="firstcorrect" TYPE="int" LENGTH="1" NOTNULL="false" COMMENT="Whether the first answer was correct. NULL: unknown"/>
        <FIELD NAME="attempts" TYPE="int" LENGTH="10" NOTNULL="false" COMMENT="How many times it was answered. NULL: unknown (row from before 1.5.0)"/>
        <FIELD NAME="timefirst" TYPE="int" LENGTH="10" NOTNULL="false" COMMENT="When it was first answered. NULL: unknown"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="ivplayerid" TYPE="foreign" FIELDS="ivplayerid" REFTABLE="ivplayer" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="ivplayerid-userid-interactionid" TYPE="unique" FIELDS="ivplayerid, userid, interactionid"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="ivplayer_vistas" COMMENT="Watched 5-second segments per user, video and day (retention curve, 1.5.0)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="ivplayerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="dia" TYPE="int" LENGTH="8" NOTNULL="true" DEFAULT="0" COMMENT="The student's local day, YYYYMMDD"/>
        <FIELD NAME="tramos" TYPE="text" NOTNULL="false" COMMENT="One digit per 5-second segment: times it was entered while playing that day (max 9)"/>
        <FIELD NAME="duracion" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Video duration in seconds, as last reported by the player"/>
        <FIELD NAME="segundos" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Seconds of video played that day (media time, jumps excluded)"/>
        <FIELD NAME="sesiones" TYPE="text" NOTNULL="false" COMMENT="Internal: what was last added from each of the last 4 page loads, so a resent save is not counted twice"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="ivplayerid" TYPE="foreign" FIELDS="ivplayerid" REFTABLE="ivplayer" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="ivplayerid-userid-dia" TYPE="unique" FIELDS="ivplayerid, userid, dia"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="ivplayer_pulso" COMMENT="End-of-lesson check: how the lesson went, one answer per user and video (1.5.0)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="ivplayerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="respuesta" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="" COMMENT="bien, costo, perdi, poco or nada (ivplayer_pulso_opciones)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="ivplayerid" TYPE="foreign" FIELDS="ivplayerid" REFTABLE="ivplayer" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="ivplayerid-userid" TYPE="unique" FIELDS="ivplayerid, userid"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
